[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[submodule]
	active = .
[remote "origin"]
	url = https://github.com/AbdulMajid08/CIS-444-Final-Project.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[lfs]
	repositoryformatversion = 0
[branch "loginPage(Abdul)"]
	remote = origin
	merge = refs/heads/loginPage(Abdul)
	vscode-merge-base = origin/loginPage(Abdul)
[branch "validation(Haani)"]
	vscode-merge-base = origin/loginPage(Abdul)
	remote = origin
	merge = refs/heads/validation(Haani)
[branch "dashboardPage(Ashley)"]
	remote = origin
	merge = refs/heads/dashboardPage(Ashley)
	vscode-merge-base = origin/dashboardPage(Ashley)
[branch "Authentication"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/Authentication
